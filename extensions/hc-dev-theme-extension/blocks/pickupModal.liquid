<div id="pickup-modal-embed"  class="hc-modal-embed">
  <div class="hc-modal">
    <button onclick="closePickupModal()" 
      style="
          position:absolute;
          top:10px;
          right:10px;
          background:none;
          border:none;
          font-size:2rem;
          cursor:pointer;
      ">&times;</button>
    <h2 style="text-align: center;">Pickup Today</h2>
    <div id="hc-pickup-modal__search" class="hc-modal__search">
      <div class="hc-input-wrapper">
        <input id="pickup-modal-zipcode-input" type="text" placeholder="Enter zipcode">
        <img id="hc-location-icon" src="{{ 'LocationIcon.svg' | asset_url }}" alt="Location Icon" height="20px" width="20px" data-picklocation="false">
      </div>
      <button class="hc-modal-find-stores-btn" onclick="searchStoresByZip(document.getElementById('pickup-modal-zipcode-input').value)"
      >Find Stores</button>
    </div>
    {% render 'store' %}
  </div>
</div>
<script>
  const locationIcon = document.getElementById('hc-location-icon');

  locationIcon
    .addEventListener('click', async () => {
      try {
        // Clear any previous value from Search Bar
        document.getElementById('pickup-modal-zipcode-input').value = '';
        const pickLocation = locationIcon.dataset.picklocation === 'true';
        if (pickLocation) {
          resetStoreList();
          const container = document.getElementById('store-list');
          container.dataset.point = '';
          generateStoreListHTML(container);
          initializePagination(container);
          locationIcon.dataset.picklocation = 'false';
          locationIcon.src = '{{ 'LocationIcon.svg' | asset_url }}';
          return;
        }
        const position = await getCurrentLocation();

        console.log(`Current location - Latitude: ${position.coords.latitude}, Longitude: ${position.coords.longitude}`);
        searchStoresByLocation(position.coords.latitude, position.coords.longitude);

        locationIcon.dataset.picklocation = 'true';
        locationIcon.src = '{{ 'LocationFilledIcon.svg' | asset_url }}';
      } catch (error) {
        console.error("Error in Searching stores by current location");
        // reset the location icons state to what it was.
        if (pickLocation) {
          locationIcon.dataset.picklocation = 'false';
          locationIcon.src = '{{ 'LocationIcon.svg' | asset_url }}';
        } else {
          locationIcon.dataset.picklocation = 'true';
          locationIcon.src = '{{ 'LocationFilledIcon.svg' | asset_url }}';
        }
      }
    });
</script>
{% schema %}
{
  "name": "Pickup Modal",
  "target": "body",
  "stylesheet": "hcBopis.css",
  "javascript": "hcBopis.js",
  "settings": []
}
{% endschema %}