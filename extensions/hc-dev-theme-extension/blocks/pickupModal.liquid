<div id="pickup-modal-embed"  class="hc-modal-embed">
  <div class="hc-modal">
    <button onclick="closePickupModal()" 
      style="
          position:absolute;
          top:10px;
          right:10px;
          background:none;
          border:none;
          font-size:2rem;
          cursor:pointer;
      ">&times;</button>
    <h2 style="text-align: center;">Pickup Today</h2>
    <div class="hc-pickup-modal__search">
      <input id="pickup-modal-zipcode-input" class="hc-zipcode-input" type="text" placeholder="Enter zipcode">
      <img id="hc-location-icon" src="{{ 'icon-map-pin.svg' | asset_url }}" alt="Location Icon" height="20" width="20" data-picklocation="false">
      <button class="hc-modal-find-stores-btn" onclick="searchStoresByZip(document.getElementById('pickup-modal-zipcode-input').value)"
      >Find Stores</button>
    </div>
    {% render 'store' %}
  </div>
</div>
<script>
  document.getElementById('hc-location-icon')
    .addEventListener('click', async () => {
      if (document.getElementById('hc-location-icon').dataset.picklocation === 'true') {
        document.getElementById('hc-location-icon').dataset.picklocation = 'false';
        resetStoreList();
        const container = document.getElementById('store-list');
        container.dataset.point = '';
        generateStoreListHTML(container);
        initializePagination(container);
        return;
      }
      document.getElementById('hc-location-icon').dataset.picklocation = 'true';
      console.log('Location icon clicked');
      const position = await getCurrentLocation();

      console.log(`Current location - Latitude: ${position.coords.latitude}, Longitude: ${position.coords.longitude}`);
      searchStoresByLocation(position.coords.latitude, position.coords.longitude);
    });
</script>
{% schema %}
{
  "name": "Pickup Modal",
  "target": "body",
  "stylesheet": "hcBopis.css",
  "javascript": "hcBopis.js",
  "settings": []
}
{% endschema %}