<my-store
  id="my-store"
  data-customer-id='8749749502116'
  data-customer='{{ customer.id }}'
  data-customer-name='{{ customer.first_name }}'
  data-customer-last-name='{{ customer.last_name }}'
  data-store-id='{{ shop.id }}'
  data-enable-warehouse-pickup='{{ block.settings.enable_pick_up_warehouse }}'
  data-show-timings='{{ block.settings.show_store_weekly_timings }}'
  data-show-my-store-in-search='{{ block.settings.show_homestore_search_result }}'
>
  <div id="my-store-label">
    {{ block.settings.my_store_label }}
  </div>
  <div id="my-store-details"></div>
</my-store>
{% schema %}
{
  "name": "My Store",
  "target": "section",
  "stylesheet": "hcBopis.css",
  "javascript": "hcBopis.js",
  "enabled_on": {
    "templates": ["*"],
    "groups": ["header"]
  },
  "settings": [
    {
      "label": "My Store Label",
      "id": "my_store_label",
      "type": "text",
      "default": "My Store",
      "info": "Label for my store in the header"
    },
    {
      "label": "Include warehouse for pick up",
      "id": "enable_pick_up_warehouse",
      "type": "checkbox",
      "default": false,
      "info": "Control whether to display warehouses in the store selection list for pick up"
    },
    {
      "label": "Show store weekly timing",
      "id": "show_store_weekly_timings",
      "type": "checkbox",
      "default": false,
      "info": "Control the UI to whether display the store weekly timing with the store information"
    },
    {
      "label": "Include home store in search results",
      "id": "show_homestore_search_result",
      "type": "checkbox",
      "default": false,
      "info": "Include the selected home store in the search results, not recommended as the same store will be displayed twice once as a home store another in the search results."
    }
  ]
}
{% endschema %}
